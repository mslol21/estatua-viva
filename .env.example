# ========================================================
# ESTÁTUA VIVA PRODUÇÕES - CONFIGURAÇÕES DE ANALYTICS & SEO
# ========================================================

# 1. URL Oficial do Site (para Canonical, Sitemap e OpenGraph)
NEXT_PUBLIC_SITE_URL=https://estatuavivaproducoes.com.br

# 2. Google Tag Manager (GTM)
# Obtenha em https://tagmanager.google.com/
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-TVHJP4QK

# 3. Google Analytics 4 (GA4)
# Opcional se já estiver configurado dentro do GTM, ou use standalone
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# 4. Google Search Console (Verificação de Posicionamento e Indexação)
# Código da meta tag de verificação html
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 5. Bing Webmaster Tools (Verificação de Busca Microsoft Bing)
# Código msvalidate.01
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# 6. Microsoft Clarity (Mapas de calor e gravações de sessão gratuitas)
# Obtenha em https://clarity.microsoft.com/
NEXT_PUBLIC_CLARITY_ID=
